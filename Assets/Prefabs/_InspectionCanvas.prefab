  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A man doesn't stray from the path. Between the supply dock and my shack,
    the world is just wide enough \u2013 and I had convinced myself that was enough.
    Eight years of the same stones underfoot, the same wind at my back. Eight years
    of knowing exactly where I belonged. And yet. One step off the gravel. Then another.
    The bushes gave way to a hidden path, the path to a ladder, the ladder to a room
    that had no right to exist.\_"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
