    },
    "m_Name": "Test (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1447.0001220703125,
            "y": -78.00009155273438,
            "width": 249.0,
            "height": 262.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "ee82221ed21347b7a31ffc2553bd6f9d"
        },
        {
            "m_Id": "9c98eb3e283e4325887ef0976fab4d8b"
        },
        {
            "m_Id": "ee426ae85c634d27bcc8b70632106825"
        },
        {
            "m_Id": "703ba28eb72e42bd90896cef253dc045"
        },
        {
            "m_Id": "7ee3a14056854f0aae9394290978d045"
        },
        {
            "m_Id": "06524f4fc0954c5691d1a063fa12e90a"
        },
        {
            "m_Id": "01e41a66310047a19e8577266b793ca2"
        },
        {
            "m_Id": "6968cacea4fc4efd9c6ece87bb1fabe5"
        },
        {
            "m_Id": "b9a6e3ce6ceb474bb815b21fe6c022f9"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Test",
    "m_FunctionSource": "c25eeef50b5841346a4a22dae98cb91d",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float dist = distance(PositionWS, CameraPositionWS);\nfloat extinction = exp(-dist / max(0.001, Visibility));\nfloat fogAmount = 1.0 - extinction;\n\nfloat h = saturate((PositionWS.y - HeightStart) / max(0.001, HeightEnd - HeightStart));\nfloat heightFactor = pow(1.0 - h, HeightFalloff);\n\nfloat blend = saturate(fogAmount * heightFactor);\n\nOutColor = lerp(BaseColor, FogColor, blend);"
}

