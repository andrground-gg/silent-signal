  m_Name: Note_LighthouseExperiments1
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  title: Responses to Light Patterns
  key: 10
  topic: 2
  boardContentText: Researchers discovered that light patterns produced responses
  boardSprite: {fileID: 0}
  contentText: "I have been on the island for over a month and no one has come for
    me. No one acknowledges me, as if I were a ghost.\n\n...the same thing, again
    and again. I transmit a light pattern. I get a response. Not chance. Every time.\n\nVogel
    knows. Smith knows. I know. And yet we are not allowed to say it out loud.\n\n\u2014
    Dr. Friedrich Kellerstein"
  paperSprite: {fileID: 21300000, guid: cea3c49c6ad23de4286197f5004fc48e, type: 3}
