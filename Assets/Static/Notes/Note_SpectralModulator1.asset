  m_Script: {fileID: 11500000, guid: e1bd7ffe4606ce749a81aac1c495eb14, type: 3}
  m_Name: Note_SpectralModulator1
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  title: Spectral Modulator Functionality
  key: 8
  topic: 1
  boardContentText: Spectral modulator converts lighthouse beam into ultraviolet
    light
  boardSprite: {fileID: 0}
  contentText: "My working relationship with Dr. Vogel has ended. I refused to take
    part in his side project. He took it as a betrayal. He dismissed me.\nI am worried
    about my career. Vogel has influence. The words he said in front of everyone
    were not idle.\nThe ship that was supposed to arrive three weeks ago has not
    come. I keep trying to convince myself it is just an ordinary delay. Something
    tells me it is not.\nAnd yet.\nVogel's work functions. The spectral modulator
    he assembled converts the lighthouse beam into ultraviolet light. I measured
    it twice. There is no doubt.\nI do not like who he is. And I cannot disagree
    with what he has discovered.\n\u2014 Dr. Kellerstein"
  paperSprite: {fileID: 0}
