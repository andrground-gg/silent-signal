  m_Script: {fileID: 11500000, guid: e1bd7ffe4606ce749a81aac1c495eb14, type: 3}
  m_Name: Note_Audio_MaritimeIncidents2
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  title: Incidents and Lighthouse Connection
  key: 24
  topic: 1
  boardContentText: Incidents stopped when lighthouse worked normally
  boardSprite: {fileID: 0}
  contentText: 'EMIL: Recording again. Another finding.

    [pause]

    EMIL: I
    set the rotation back to the original rhythm. Water calm. No fog. Nothing strange.

    [brief
    silence]

    EMIL: Then I changed it again. Right away, the mess came back.
    Water up, water down. Fog where it shouldn''t be.

    [pause]

    EMIL: Whenever
    the lighthouse runs normally, it''s quiet. Whenever I mess with it, this is what
    happens.

    [brief silence]

    EMIL: I don''t know how it fits together.
    But it does.

    [pause]

    EMIL: I''ve never seen this anywhere else. And
    I spent almost my whole life on a military ship. I''ve seen the ocean in shapes
    a normal person couldn''t even imagine. Storms, frosts, fogs. Water levels that
    looked like the end of the world.

    [brief silence]

    EMIL: But this? Never
    anywhere.

    [click]'
  paperSprite: {fileID: 0}
